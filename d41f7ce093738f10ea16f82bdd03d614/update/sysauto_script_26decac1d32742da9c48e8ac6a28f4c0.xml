        <script><![CDATA[(function () {
    /**
     * CSR Monthly KPI Calculator
     * Runs on the 1st of every month to calculate all 6 KPIs.
     * Uses the KPI engine module for the actual computation.
     */
    try {
        gs.info('CSR KPI Calculator: Starting monthly KPI calculation...');
        var kpiEngine = require('engines/kpi-engine');
        kpiEngine.calculateAllKPIs();
        gs.info('CSR KPI Calculator: Monthly KPI calculation completed.');
    } catch (e) {
        gs.error('CSR KPI Calculator failed: ' + e.message);
    }
})();
]]></script>
